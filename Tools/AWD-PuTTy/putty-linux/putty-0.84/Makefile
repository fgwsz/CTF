sshserver: cmake_check_build_system
	$(MAKE) $(MAKESILENT) -f CMakeFiles/Makefile2 sshserver
.PHONY : sshserver

# fast build rule for target.
sshserver/fast:
	$(MAKE) $(MAKESILENT) -f ssh/CMakeFiles/sshserver.dir/build.make ssh/CMakeFiles/sshserver.dir/build
.PHONY : sshserver/fast

