	cd /home/fgwsz/Gitpro/CTF/Tools/AWD-PuTTy/putty-linux/putty-0.84 && $(CMAKE_COMMAND) -S$(CMAKE_SOURCE_DIR) -B$(CMAKE_BINARY_DIR) --check-build-system CMakeFiles/Makefile.cmake 0
